{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Postern",
  "colors": {
    "primary": "#E7A42A",
    "light": "#E7A42A",
    "dark": "#B83E15"
  },
  "background": {
    "color": {
      "light": "#F5EDDA",
      "dark": "#151F19"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "styling": {
    "codeblocks": "system"
  },
  "fonts": {
    "heading": {
      "family": "Cormorant Garamond",
      "source": "/fonts/cormorant-garamond-var.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Source Serif 4",
      "source": "/fonts/source-serif-4-var.woff2",
      "format": "woff2"
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "start/install",
          "start/remote-access",
          "start/first-key",
          "start/connect-an-agent"
        ]
      },
      {
        "group": "Connect a source",
        "pages": [
          {
            "group": "Money",
            "pages": [
              "connect/simplefin",
              "connect/plaid"
            ]
          },
          {
            "group": "Health",
            "pages": [
              "connect/apple-health",
              "connect/whoop"
            ]
          },
          {
            "group": "Mail, calendar & contacts",
            "pages": [
              "connect/google",
              "connect/microsoft",
              "connect/icloud"
            ]
          },
          {
            "group": "Home",
            "pages": [
